{
  "manifest_version": 3,
  "name": "Ignore Facebook Follow",
  "version": "1.1.0",
  "description": "Automatically hide posts from Facebook pages/users that you don't want to see",
  "author": "Your Name",
  "permissions": ["activeTab", "storage"],
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["index.js"]
    }
  ],
  "action": {
    "default_title": "Ignore Facebook Follow",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
